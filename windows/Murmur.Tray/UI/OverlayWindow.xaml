<Window x:Class="Murmur.UI.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Murmur" Width="360" Height="64" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        ResizeMode="NoResize" Focusable="False" IsHitTestVisible="False">
    <Border Background="#E6101418" CornerRadius="22" Padding="18,10" BorderBrush="#4D9A8CF5" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="Meter" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                <Rectangle x:Name="Bar1" Width="4" Height="8" RadiusX="2" RadiusY="2" Fill="#FFC9D1FF" Margin="1,0" />
                <Rectangle x:Name="Bar2" Width="4" Height="14" RadiusX="2" RadiusY="2" Fill="#FFC9D1FF" Margin="1,0" />
                <Rectangle x:Name="Bar3" Width="4" Height="20" RadiusX="2" RadiusY="2" Fill="#FFC9D1FF" Margin="1,0" />
                <Rectangle x:Name="Bar4" Width="4" Height="14" RadiusX="2" RadiusY="2" Fill="#FFC9D1FF" Margin="1,0" />
                <Rectangle x:Name="Bar5" Width="4" Height="8" RadiusX="2" RadiusY="2" Fill="#FFC9D1FF" Margin="1,0" />
            </StackPanel>
            <TextBlock x:Name="Caption" Grid.Column="1" Foreground="#FFF2F4FF" FontSize="14" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Text="Listening…" />
        </Grid>
    </Border>
</Window>
