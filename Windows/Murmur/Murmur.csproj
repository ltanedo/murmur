<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 2004 (19041) or later: gives us the Windows.Media.SpeechRecognition projection. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Murmur</RootNamespace>
    <AssemblyName>Murmur</AssemblyName>
    <Version>1.0.0</Version>
    <Product>Murmur</Product>
    <Description>Private, on-device voice dictation for the Windows tray.</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Unpackaged desktop app: no MSIX, no store, no app identity. -->
    <WindowsPackageType>None</WindowsPackageType>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

</Project>
